DEFINE SCHEMA

    CREATE ROLE HLRolloutAdmin;

    RECORD TYPE HLMeta (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        deletedAt       TIMESTAMP,
        formatVersion   INT64,
        updatedAt       TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE HLProfile (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        avatarData      ASSET,
        avatarUpdatedAt TIMESTAMP,
        createdAt       TIMESTAMP,
        deletedAt       TIMESTAMP,
        displayName     STRING,
        nameUpdatedAt   TIMESTAMP,
        updatedAt       TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE HLProject (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        colorHex        STRING,
        createdAt       TIMESTAMP,
        deletedAt       TIMESTAMP,
        name            STRING,
        sortOrder       INT64,
        updatedAt       TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE HLRollout (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        minBuild        INT64,
        paused          INT64,
        GRANT READ TO "_world",
        GRANT WRITE, CREATE, READ TO HLRolloutAdmin
    );

    RECORD TYPE HLSavedFilter (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        colorHex        STRING,
        createdAt       TIMESTAMP,
        deletedAt       TIMESTAMP,
        name            STRING,
        query           STRING,
        sortOrder       INT64,
        updatedAt       TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE HLSwitchboard (
        "___createTime"    TIMESTAMP,
        "___createdBy"     REFERENCE,
        "___etag"          STRING,
        "___modTime"       TIMESTAMP,
        "___modifiedBy"    REFERENCE,
        "___recordID"      REFERENCE QUERYABLE,
        cadence            STRING,
        createdAt          TIMESTAMP,
        deletedAt          TIMESTAMP,
        name               STRING,
        overdueBecomesTask INT64,
        resetMinutes       INT64,
        resetWeekday       INT64,
        sortOrder          INT64,
        updatedAt          TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE HLTaskItem (
        "___createTime"       TIMESTAMP,
        "___createdBy"        REFERENCE,
        "___etag"             STRING,
        "___modTime"          TIMESTAMP,
        "___modifiedBy"       REFERENCE,
        "___recordID"         REFERENCE QUERYABLE,
        completedAt           TIMESTAMP,
        createdAt             TIMESTAMP,
        deadline              TIMESTAMP,
        deletedAt             TIMESTAMP,
        dueDate               TIMESTAMP,
        flipCount             INT64,
        flipPeriodStart       TIMESTAMP,
        flipTarget            INT64,
        hasDueTime            INT64,
        isCompleted           INT64,
        labels                LIST<STRING>,
        locationName          STRING,
        notes                 STRING,
        overdueBecomesTask    INT64,
        parent                STRING,
        priority              INT64,
        project               STRING,
        recurrence            STRING,
        reminderDate          TIMESTAMP,
        reminderOffsetMinutes INT64,
        sortOrder             INT64,
        switchboard           STRING,
        title                 STRING,
        updatedAt             TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE HLTaskLabel (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        colorHex        STRING,
        createdAt       TIMESTAMP,
        deletedAt       TIMESTAMP,
        name            STRING,
        updatedAt       TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
